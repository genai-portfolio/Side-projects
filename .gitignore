# ------------------------------
# Monorepo baseline ignores
# ------------------------------

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# IDE / editor configs
.idea/
.vscode/
.cursor/
*.iml

# Node.js / Next.js / Vite
**/node_modules/
**/.next/
**/.nuxt/
**/dist/
**/build/
**/.turbo/
**/.cache/
**/coverage/
**/.eslintcache
**/*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
**/__pycache__/
**/*.py[cod]
**/.ipynb_checkpoints/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.tox/
**/.nox/
**/.hypothesis/
**/.coverage
**/htmlcov/
**/site/

# Python virtual environments (recursive)
**/.env
**/.env.*
!**/.env.template
**/.venv/
**/venv/
**/env/
**/ENV/

# Archives
*.zip

# Large files / ML artifacts (prevent accidental heavy commits)
# Note: .gitignore cannot filter by file size, only by pattern.
**/downloads/
**/checkpoints/
**/artifacts/
**/weights/

*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.onnx
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.npy
*.npz
*.parquet
*.feather

*.db
*.sqlite
*.sqlite3

*.mp4
*.mov
*.avi
*.mkv
*.webm

*.pdf
*.epub
